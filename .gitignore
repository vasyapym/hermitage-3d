node_modules/
dist/
coverage/
test-results/
playwright-report/
.DS_Store
.env*
*.local
probes/
# RG-F3: the capture/gate INSTRUMENTS under tools/probes/ are committed code (the
# capture frames stay local-only — the root probes/ rule above covers them).
!tools/probes/
tools/probes/**
!tools/probes/*.py
!tools/probes/*.mjs
!tools/probes/*.md
# The jordan-fixtures B0 census REPORTS are committed records — the unanchored
# probes/ rule above swallows the docs/probes/ DIRECTORY, so re-include it (the
# files inside carry no rule of their own).
!docs/probes/
*.blend1
*.blend2
tools/fonts/.venv/
.agent/
__pycache__/
.cache/
out/
tools/bpy/plafond-art.png
tools/bpy/st-george-ornament-*.png
