{
  "name": "zimny",
  "private": true,
  "type": "module",
  "description": "Zimny \u2014 a stylized 3D recreation of the Winter Palace (Hermitage, Saint Petersburg) in the browser.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "budget": "node tools/budget.mjs",
    "fonts": "node tools/fonts/subset.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "asset:bpy": "node tools/asset.mjs bpy",
    "asset:gltf": "node tools/asset.mjs gltf",
    "asset:bake": "node tools/asset.mjs bake",
    "asset:manifest": "node tools/asset.mjs manifest",
    "asset:basis": "node tools/asset.mjs basis",
    "asset:gallery-layout": "node tools/gallery/layout.mjs",
    "asset": "node tools/asset.mjs all",
    "gallery:transcribe": "node tools/gallery/import.mjs transcribe",
    "gallery:fetch": "node tools/gallery/import.mjs fetch",
    "gallery:lock": "node tools/gallery/import.mjs lock",
    "gallery:compose": "node tools/gallery/import.mjs compose",
    "gallery:encode": "node tools/gallery/import.mjs encode",
    "gallery:verify": "node tools/gallery/import.mjs verify",
    "gallery:attrib": "node tools/gallery/import.mjs attrib",
    "gallery:report": "node tools/gallery/import.mjs report",
    "gallery:all": "node tools/gallery/import.mjs all"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/cli": "4.5.1",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-serif": "2.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.186.0",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "jpeg-js": "0.4.4"
  }
}
